# Normalize text files to LF in the repo; convert as needed in working dir via explicit rules
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix shell scripts use LF
*.sh text eol=lf

# Common source/text files use LF
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.svg  text eol=lf
*.txt  text eol=lf
*.gitignore text eol=lf

# Treat lock files as text but keep exact bytes (avoid unintended EOL changes)
package-lock.json -text

# Binary assets (never modify line endings)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.mp4  binary
*.mp3  binary
*.mov  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.7z   binary
